# Server-only SMTP settings. Fill in when Support mailbox access is available.
# Never commit real secrets or use NEXT_PUBLIC_ for credentials.
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
# Port 587: SMTP_SECURE=false (STARTTLS required).
# Account must be authorized to send as Support@happyglobalservice.com.
# Legacy ZOHO_EMAIL / ZOHO_APP_PASSWORD remain supported as fallback.
